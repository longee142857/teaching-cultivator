# Example nginx for practice desk (teaching-shell + /api/v1/*).
# App: deliver/practice_web.py on 127.0.0.1:8768
# Public: https://practice.longee.icu  (Cloudflare DNS A → this VPS)
#
# Optional tutor: set TUTOR_BACKEND_URL=http://127.0.0.1:61900 on the app,
# or uncomment the direct proxy block below to DSH mentor-team.

server {
    listen 80;
    listen [::]:80;
    server_name practice.longee.icu;

    location / {
        proxy_pass http://127.0.0.1:8768;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Learner-Id $http_x_learner_id;
        proxy_read_timeout 120s;
    }

    # Direct DSH path (alternative to app-level TUTOR_BACKEND_URL):
    # location = /api/v1/tutor/chat {
    #     proxy_pass http://127.0.0.1:61900;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Learner-Id $http_x_learner_id;
    #     proxy_read_timeout 120s;
    # }
}
