# Example nginx site snippet for biweekly exam H5.
# App listens on 127.0.0.1:8766 (EXAM_WEB_HOST / EXAM_WEB_PORT).
# Only reverse-proxy /e/ and /health ¡ª do not expose papers/ or keys/.
#
# Cloud note (2026-07-28): host currently uses HTTP on :80
#   EXAM_WEB_PUBLIC_BASE=http://154.8.196.179
# Prefer HTTPS when a domain + cert is available (see TLS block below).

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /e/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8766/health;
    }

    location / {
        return 404;
    }
}

