# Example nginx site snippet for teaching ops monitor board.
# App listens on 127.0.0.1:8767 (OPS_WEB_HOST / OPS_WEB_PORT).
# Reverse-proxy /ops/ only. Require OPS_VIEW_TOKEN on the app side (?token=).
#
# Merge into the same server block that already proxies /e/ -> :8766.

# location /ops/ {
#     proxy_pass http://127.0.0.1:8767;
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
#
# location = /ops/health {
#     proxy_pass http://127.0.0.1:8767/ops/health;
# }

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /e/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ops/ {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8766/health;
    }

    location / {
        return 404;
    }
}
