# Local secrets — DO NOT COMMIT

# LLM
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# OpenRouter（Agent / reviewer 共用）
# OPENROUTER_API_KEY=
# AGENT_MODEL=anthropic/claude-haiku-4.5
# REVIEWER_MODEL=qwen/qwen3.6-plus

# SSL certificate verification (BIG-TEACH-012d #15)
# SSL_VERIFY=0  # Only disable for corporate proxy / self-signed certs
# SSL_VERIFY=1  # Default; enabled

# DingTalk Stream (primary channel)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# DINGTALK_GROUP_CONVERSATION_ID=
# DINGTALK_DISCUSS_IN_DM=1

# WeCom fallback (optional)
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_WEBHOOK=

# Optional kb_cache HTTP
# KB_CACHE_TOKEN=
# KB_CACHE_PORT=8765
# KB_CACHE_HOST=127.0.0.1

# RAG / external knowledge helper (optional)
# RAG_STRICT=1
# RAG_FALLBACK=abort
# KB_PATH=
# KB_LIB=
# KB_QUERY_HELPER=
# KB_PYTHON=
# KB_WARM_BATCH=
# DAILY_RECORD_DIR=

# Learner identity
# OWNER_STAFF_ID=04022300   # 课表/公共课策略账户（钉钉 staffId）；多人模式必填
# LEARNER_USER_ID=wx_123    # 仅旧单人/测试兼容；运行时用 ContextVar staffId

# Biweekly exam H5 (KaTeX viewer; nginx TLS → 127.0.0.1)
# EXAM_WEB_PUBLIC_BASE=https://your.host
# EXAM_VIEW_SECRET=change-me-long-random
# EXAM_WEB_PORT=8766
# EXAM_WEB_HOST=127.0.0.1
# EXAM_TOKEN_TTL_DAYS=14
# EXAM_WEB_HTTP=1
# EXAM_PUSH_PNG=0
# EXAM_SUBMIT_LIMIT_PER_HOUR=5

# Ops monitor board (rejects + learner params; nginx /ops/ -> :8767)
# OPS_WEB_HTTP=1
# OPS_WEB_HOST=127.0.0.1
# OPS_WEB_PORT=8767
# OPS_VIEW_TOKEN=change-me-ops-token
