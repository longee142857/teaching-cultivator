# Local secrets — DO NOT COMMIT

# LLM
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# Agent：DeepSeek Flash 直连（0731 Agent 强化；默认同 MODEL_FLASH）
# AGENT_MODEL=deepseek-v4-flash
# AGENT_THINKING=1
# AGENT_REASONING_EFFORT=max
# OpenRouter（可选遗留；默认审查已改走百炼，勿在腾讯云上靠代理翻墙）
# OPENROUTER_API_KEY=
# REVIEWER_PROVIDER=dashscope
# REVIEWER_MODEL=qwen-plus
# 阿里云百炼（北京 OpenAI 兼容；review_item / verify_grade）
# DASHSCOPE_API_KEY=
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# SimpleTex 手写 OCR（私聊发图批改；UAT 或 APP 二选一）
# SIMPLETEX_UAT=
# SIMPLETEX_APP_ID=
# SIMPLETEX_APP_SECRET=
# SIMPLETEX_OCR_MODE=general
# SIMPLETEX_ENABLED=1
# SIMPLETEX_API_BASE=https://server.simpletex.cn

# SSL certificate verification (BIG-TEACH-012d #15)
# SSL_VERIFY=0  # Only disable for corporate proxy / self-signed certs
# SSL_VERIFY=1  # Default; enabled

# DingTalk Stream (primary channel)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# DINGTALK_GROUP_CONVERSATION_ID=
# DINGTALK_DISCUSS_IN_DM=1

# WeCom fallback (optional)
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_WEBHOOK=

# Optional kb_cache HTTP
# KB_CACHE_TOKEN=
# KB_CACHE_PORT=8765
# KB_CACHE_HOST=127.0.0.1

# RAG / external knowledge helper (optional)
# RAG_STRICT=1
# RAG_FALLBACK=abort
# KB_PATH=
# KB_LIB=
# KB_QUERY_HELPER=
# KB_PYTHON=
# KB_WARM_BATCH=
# DAILY_RECORD_DIR=

# BIG-TEACH-013: SQLite 真相源库（默认 DATA_DIR/teaching.db；留空即默认）
# TEACHING_DB=

# Learner identity
# OWNER_STAFF_ID=04022300   # 课表/公共课策略账户（钉钉 staffId）；多人模式必填
# LEARNER_USER_ID=wx_123    # 仅旧单人/测试兼容；运行时用 ContextVar staffId

# Biweekly exam H5 (KaTeX viewer; nginx TLS → 127.0.0.1)
# EXAM_WEB_PUBLIC_BASE=https://your.host
# EXAM_VIEW_SECRET=change-me-long-random
# EXAM_WEB_PORT=8766
# EXAM_WEB_HOST=127.0.0.1
# EXAM_TOKEN_TTL_DAYS=14
# EXAM_WEB_HTTP=1
# EXAM_PUSH_PNG=0
# EXAM_SUBMIT_LIMIT_PER_HOUR=5

# Ops monitor board (rejects + learner params; nginx /ops/ -> :8767)
# OPS_WEB_HTTP=1
# OPS_WEB_HOST=127.0.0.1
# OPS_WEB_PORT=8767
# OPS_VIEW_TOKEN=change-me-ops-token

# Teaching system whitelist API (any agent; localhost)
# SYSTEM_API_HTTP=1
# SYSTEM_API_HOST=127.0.0.1
# SYSTEM_API_PORT=8770
# SYSTEM_API_TOKEN=change-me-system-api-token

# Frontend deep links for notify-only IM（答题/讲解在前端）
# FRONTEND_BASE_URL=https://your.host

# Pi RPC interaction layer (DingTalk wake; Pi files live outside this git)
# PI_RPC_ENABLED=0
# PI_RPC_HOST=127.0.0.1
# PI_RPC_PORT=8780
# PI_SESSION_DIR=/home/ubuntu/pi-sessions
# PI_WORKSPACE=/home/ubuntu/pi-workspace
# PI_RPC_CMD=
# PI_RPC_TIMEOUT=180
