  "question": "求极限 L=lim_{x→0} (e^x-1-x)/x^2（写出主要变形步骤，勿跳步）。",
  "answer": "L=1/2。",
  "techniques": [
    "泰勒/麦克劳林一阶",
    "等价无穷小 e^x-1~x",
    "代数消去"
  ],
  "solution": {
    "steps": [
      {
        "id": "s1",
        "text": "e^x=1+x+x^2/2+o(x^2)，故 e^x-1-x=x^2/2+o(x^2)"
      },
      {
        "id": "s2",
        "text": "分子除以 x^2 得 1/2+o(1)"
      },
      {
        "id": "s3",
        "text": "x→0 时 L=1/2。"
      }
    ],
    "final_answer": "L=1/2。",
    "techniques_used": [
