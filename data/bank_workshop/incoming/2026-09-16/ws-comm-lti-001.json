  "question": "LTI 系统冲激响应 h(t)=e^{-t}u(t)。构造输入 x(t)=δ(t)-δ(t-1) 时输出 y(t) 的时域表达式（用 u(t) 分段写出）。",
  "answer": "y(t)=e^{-t}u(t)-e^{-(t-1)}u(t-1)。",
  "techniques": [
    "卷积与冲激串",
    "因果系统移位叠加",
    "u(t) 分段"
  ],
  "solution": {
    "steps": [
      {
        "id": "s1",
        "text": "y=h*x，x 为两冲激之和"
      },
      {
        "id": "s2",
        "text": "h(t)*δ(t)=h(t)；h(t)*δ(t-1)=h(t-1)=e^{-(t-1)}u(t-1)"
      },
      {
        "id": "s3",
        "text": "相减得 y(t)=e^{-t}u(t)-e^{-(t-1)}u(t-1)。"
      }
    ],
    "final_answer": "y(t)=e^{-t}u(t)-e^{-(t-1)}u(t-1)。",
