  "difficulty": "",
  "question": "周期为 T 的方波 s(t)=A（0≤t<T/2）且 s(t)=−A（T/2≤t<T），在 t∈[0,T) 上按指数形式傅里叶级数 s(t)=∑_{n=−∞}^{∞} c_n e^{j2πnt/T} 展开。求直流分量 a_0 与基波（n=±1）复系数 c_1（用 A、T 表示）。",
  "answer": "a_0=0；c_1=2A/(jπ)（故 c_{−1}=−2A/(jπ)）。",
  "techniques": [
    "指数傅里叶级数系数公式",
    "奇对称方波去直流",
    "分段指数积分"
  ],
  "solution": {
    "steps": [
      {
        "id": "s1",
        "text": "a_0=(1/T)∫_0^T s(t)dt，正负半周抵消得 a_0=0"
      },
      {
        "id": "s2",
        "text": "c_n=(1/T)∫_0^T s(t)e^{−j2πnt/T}dt；令 ω_0=2π/T，n=1 时 c_1=(A/T)[∫_0^{T/2}e^{−jω_0 t}dt−∫_{T/2}^T e^{−jω_0 t}dt]"
      },
      {
        "id": "s3",
        "text": "∫_0^{T/2}e^{−jω_0 t}dt=(e^{−jπ}−1)/(−jω_0)=T/(jπ)； ∫_{T/2}^T e^{−jω_0 t}dt=(1−e^{−jπ})/(−jω_0)=−T/(jπ)"
      },
      {
        "id": "s4",
        "text": "代入得 c_1=(A/T)·2T/(jπ)=2A/(jπ)。"
      }
    ],
    "final_answer": "a_0=0；c_1=2A/(jπ)（故 c_{−1}=−2A/(jπ)）。",
    "techniques_used": [
      "指数傅里叶级数系数公式",
      "奇对称方波去直流",
      "分段指数积分"
    ]
  },
