  "solution": {
    "steps": [
      {
        "id": "s1",
        "text": "dy/y=tan x dx，两边积分 ln|y|=−ln|cos x|+C。"
      },
      {
        "id": "s2",
        "text": "y=K/cos x；y(0)=1 ⇒ K=1，y=sec x。"
      }
    ],
