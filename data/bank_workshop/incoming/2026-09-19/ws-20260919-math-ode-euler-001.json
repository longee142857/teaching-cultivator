  "question": "求欧拉方程 x²y''+xy'−y=0 (x>0) 的通解。",
  "answer": "y=C₁ x+C₂/x。",
  "techniques": [
    "欧拉代换",
    "常系数化",
    "特征根"
  ],
  "solution": {
    "steps": [
      {
        "id": "s1",
        "text": "令 x=e^t 或设 y=x^m 得指标方程 m(m−1)+m−1=0。"
      },
      {
        "id": "s2",
        "text": "m²−1=0 ⇒ m=±1，通解 y=C₁ x+C₂ x^{−1}。"
      }
    ],
    "final_answer": "y=C₁ x+C₂/x。",
