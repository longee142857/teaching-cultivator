  "question": "求由 y=x 与 y=x² 所围平面图形的面积。",
  "answer": "S=1/6。",
  "techniques": [
    "交点定界",
    "上减下积分",
    "定积分"
  ],
  "solution": {
    "steps": [
      {
        "id": "s1",
        "text": "交点 x=0,1；在 [0,1] 上 x≥x²。"
      },
      {
        "id": "s2",
        "text": "S=∫₀¹(x−x²)dx=[x²/2−x³/3]₀¹=1/2−1/3=1/6。"
      }
    ],
    "final_answer": "S=1/6。",
